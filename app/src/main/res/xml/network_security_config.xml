<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed so the app can talk to a TastyIgniter instance in the
     local network during setup. The login screen warns when a non-HTTPS URL is used. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
